        { name: "Papers, Please", lens: "Document inspection / consequences", strength: "Rule-based document checks, time pressure, and consequences for decisions.", opportunity: "Our focus adds memory consistency and the interpretation of supernatural evidence beyond paperwork.", url: "https://store.steampowered.com/app/239030/Papers_Please/" },
        { name: "Contraband Police", lens: "First-person checkpoint", strength: "Combining document inspection with a physical work area and additional duties.", opportunity: "Facility maintenance creates a similar workload, while horror and the Skinwalker threat form the key distinction.", url: "https://store.steampowered.com/app/756800/Border_Officer/" },
        { name: "I'm on Observation Duty", lens: "Observation / memory / anomalies", strength: "Spotting unusual events during a night shift by using attention and memory.", opportunity: "Instead of surveillance footage, our game relies on direct NPC interaction, identity checks, and UV traces.", url: "https://store.steampowered.com/app/1046820/" },
        { name: "The Operator", lens: "Digital evidence / investigation", strength: "Gathering information and connecting clues through computer tools.", opportunity: "The facility computer remains an information hub, while the player must leave the desk and take physical risks.", url: "https://store.steampowered.com/app/1771980/The_Operator/" }
