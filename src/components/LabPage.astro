const versions = Object.entries(copy);
---

<div class="nightwatch-presentation" data-project-presentation data-active-language={initialLanguage}>
  <div class="presentation-bar">
    <div class="presentation-brand">
      <span class="brand-dot" aria-hidden="true"></span>
      <span data-top-copy="tr" hidden={initialLanguage !== "tr"}>{copy.tr.topLabel}</span>
      <span data-top-copy="en" hidden={initialLanguage !== "en"}>{copy.en.topLabel}</span>
      <span class="bar-divider">/</span>
      <span class="bar-meta" data-top-meta="tr" hidden={initialLanguage !== "tr"}>{copy.tr.topMeta}</span>
      <span class="bar-meta" data-top-meta="en" hidden={initialLanguage !== "en"}>{copy.en.topMeta}</span>
    </div>
    <div class="language-control" role="group" aria-label="Presentation language">
      <button type="button" data-language-toggle="tr" aria-pressed={initialLanguage === "tr"}>TR</button>
      <button type="button" data-language-toggle="en" aria-pressed={initialLanguage === "en"}>EN</button>
    </div>
  </div>

  {versions.map(([lang, t]) => (
    <div class="deck-language" data-language-panel={lang} lang={lang} hidden={lang !== initialLanguage}>
      <div class="deck-container">
        <header class="deck-hero">
          <div class="hero-copy">
            <p class="eyebrow"><span>{t.heroKicker}</span><span class="eyebrow-line"></span></p>
            <h1>{t.heroTitle}</h1>
            <p class="hero-subtitle">{t.heroSubtitle}</p>
            <p class="hero-body">{t.heroBody}</p>
            <div class="hero-status"><span class="status-dot"></span>{t.status}</div>
            <div class="hero-meta-grid">
              {t.heroMeta.map((item) => (
                <div class="hero-meta-item">
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </div>
              ))}
            </div>
          </div>
          <aside class="facility-card" aria-label={t.facilityEyebrow}>
            <div class="facility-card-head">
              <div><p>{t.facilityEyebrow}</p><strong>{t.facilityHeader}</strong></div>
              <span class="facility-indicator"><i></i> {t.facilityStatus}</span>
            </div>
            <div class="facility-schematic">
              {t.facility.map((room, index) => (
                <div class:list={["facility-zone", index === 4 ? "zone-booth" : "", index === 0 ? "zone-restricted" : ""]}>
                  <span class="zone-index">0{index + 1}</span>
                  <span class="zone-name">{room}</span>
                  <span class="zone-mark" aria-hidden="true">{index === 0 ? "×" : index === 4 ? "↔" : "·"}</span>
                </div>
              ))}
            </div>
            <p class="facility-foot"><span>↳</span> {t.facilityFoot}</p>
            <div class="facility-card-bottom"><span>21:00</span><span class="timeline"><i></i></span><span>09:00</span></div>
          </aside>
        </header>

        <div class="presentation-intro">
          <div class="intro-index">00</div>
          <div>
            <h2>{t.introTitle}</h2>
            <p>{t.introBody}</p>
          </div>
        </div>

        <section class="fact-grid" aria-label="Project summary">
          {t.factCards.map((card, index) => (
            <article class="fact-card">
              <div class="fact-card-top"><span>0{index + 1}</span><span class="fact-arrow">↗</span></div>
              <p class="card-eyebrow">{card.label}</p>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))}
        </section>

        <nav class="section-toc" aria-label={t.navLabel}>
          <span class="toc-label">{t.tocTitle}</span>
          <div class="toc-links">
            {t.toc.map((item) => (
              <a href={`#${item.id}-${lang}`}>{item.label}<span aria-hidden="true"> ↘</span></a>
            ))}
          </div>
        </nav>

        <section class="deck-section" id={`concept-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week1.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week1.tag}</p><h2>{t.week1.title}</h2><p class="section-intro">{t.week1.intro}</p></div>
          </div>
          <div class="concept-pitch">
            <div class="pitch-label"><span class="small-square"></span>{t.week1.pitchLabel}</div>
            <p>{t.week1.pitch}</p>
            <span class="pitch-decoration" aria-hidden="true">“</span>
          </div>
          <div class="subsection-heading"><h3>{t.week1.pillarsTitle}</h3><span>01—03</span></div>
          <div class="pillar-grid">
            {t.week1.pillars.map((pillar) => (
              <article class="pillar-card">
                <span class="pillar-number">{pillar.number}</span>
                <h4>{pillar.title}</h4>
                <p>{pillar.body}</p>
              </article>
            ))}
          </div>
          <div class="loop-block">
            <div class="subsection-heading"><h3>{t.week1.loopTitle}</h3><span>CORE LOOP</span></div>
            <div class="loop-flow">
              {t.week1.loop.map((step, index) => (
                <div class="loop-step"><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong>{index < t.week1.loop.length - 1 && <i aria-hidden="true">→</i>}</div>
              ))}
            </div>
          </div>
          <aside class="editorial-note"><span class="note-mark">i</span><div><h3>{t.week1.noteTitle}</h3><p>{t.week1.note}</p></div></aside>
        </section>

        <section class="deck-section" id={`market-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week2.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week2.tag}</p><h2>{t.week2.title}</h2><p class="section-intro">{t.week2.intro}</p></div>
          </div>
          <div class="market-summary-grid">
            <article class="market-summary"><span class="market-icon">◎</span><div><h3>{t.week2.audienceTitle}</h3><p>{t.week2.audience}</p></div></article>
            <article class="market-summary market-summary-dark"><span class="market-icon">✳</span><div><h3>{t.week2.uspTitle}</h3><p>{t.week2.usp}</p></div></article>
          </div>
          <div class="subsection-heading competitor-heading"><h3>{t.week2.competitorTitle}</h3><span>05 REFERENCES</span></div>
          <p class="section-intro competitor-intro">{t.week2.competitorIntro}</p>
          <div class="competitor-list">
            {t.week2.competitors.map((game, index) => (
              <article class="competitor-row">
                <div class="competitor-index">0{index + 1}</div>
                <div class="competitor-main"><div class="competitor-titleline"><h3>{game.name}</h3><span>{game.lens}</span></div><p class="competitor-strength">{game.strength}</p><p class="competitor-opportunity"><strong>{lang === "tr" ? "Tasarım fırsatı" : "Design opportunity"}</strong>{game.opportunity}</p></div>
                <a class="external-link" href={game.url} target="_blank" rel="noreferrer">{lang === "tr" ? "Resmî sayfa" : "Official page"}<span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
          <p class="source-note"><span>*</span> {t.week2.researchNote}</p>
        </section>

        <section class="deck-section" id={`pipeline-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week3.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week3.tag}</p><h2>{t.week3.title}</h2><p class="section-intro">{t.week3.intro}</p></div>
          </div>
          <div class="tools-block">
            <div class="subsection-heading"><h3>{t.week3.toolsTitle}</h3><span>TOOLKIT</span></div>
            <div class="tool-grid">
              {t.week3.tools.map((tool) => (
                <article class="tool-card"><span class="tool-mark">↗</span><h4>{tool.name}</h4><p>{tool.role}</p></article>
              ))}
            </div>
          </div>
          <div class="roles-block">
            <div class="subsection-heading"><h3>{t.week3.rolesTitle}</h3><span>TEAM / 02</span></div>
            <div class="role-grid">
              {t.week3.roles.map((role) => (
                <article class="role-card"><p class="card-eyebrow">{role.role}</p><h3>{role.person}</h3><p>{role.body}</p></article>
              ))}
            </div>
          </div>
          <div class="flow-block">
            <div class="subsection-heading"><h3>{t.week3.flowTitle}</h3><span>PIPELINE</span></div>
            <div class="production-flow">
              {t.week3.flow.map((phase) => (
                <article class="production-phase"><span>{phase.number}</span><div><h4>{phase.title}</h4><p>{phase.body}</p></div></article>
              ))}
            </div>
          </div>
          <div class="pipeline-bottom-grid">
            <article class="principles-card"><div class="subsection-heading"><h3>{t.week3.rulesTitle}</h3><span>RULES</span></div><ul>{t.week3.rules.map((rule) => <li>{rule}</li>)}</ul></article>
            <aside class="current-stage-card"><span class="card-eyebrow">{t.week3.currentStageTitle}</span><div class="stage-mark"><span>PHASE</span><strong>10</strong></div><p>{t.week3.currentStage}</p></aside>
          </div>
        </section>

        <section class="deck-section prototype-section" id={`prototype-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week4.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week4.tag}</p><h2>{t.week4.title}</h2><p class="section-intro">{t.week4.intro}</p></div>
          </div>
          <div class="prototype-status-line"><span class="live-dot"></span><strong>{t.week4.implementationLabel}</strong><span class="status-chip">DEBUG BUILD</span></div>
          <p class="prototype-disclaimer">{t.week4.implementationNote}</p>
          <div class="feature-grid">
            {t.week4.features.map((feature, index) => (
              <article class="feature-card"><div class="feature-card-head"><span>0{index + 1}</span><span class="feature-check">✓</span></div><h3>{feature.title}</h3><p>{feature.body}</p><span class="feature-state">{lang === "tr" ? "PROTOTİPTE VAR" : "IN PROTOTYPE"}</span></article>
            ))}
          </div>
          <div class="test-plan-block">
            <div class="subsection-heading"><h3>{t.week4.testTitle}</h3><span>QA / PROTOTYPE</span></div>
            <p class="section-intro">{t.week4.testIntro}</p>
            <div class="test-grid">
              {t.week4.tests.map((test) => (
                <article class="test-card"><div class="test-card-top"><span>{test.number}</span><span class="test-circle">○</span></div><h3>{test.title}</h3><div class="test-field"><span>{lang === "tr" ? "AKIŞ" : "FLOW"}</span><p>{test.steps}</p></div><div class="test-field expected"><span>{lang === "tr" ? "BEKLENEN" : "EXPECTED"}</span><p>{test.expected}</p></div></article>
              ))}
            </div>
          </div>
          <aside class="editorial-note"><span class="note-mark">↗</span><div><h3>{t.week4.demoNoteTitle}</h3><p>{t.week4.demoNote}</p></div></aside>
        </section>

        <section class="deck-section scope-section" id={`next-${lang}`}>
          <div class="section-heading">
            <div class="section-number">NEXT</div>
            <div class="section-heading-main"><p class="eyebrow">{t.scope.tag}</p><h2>{t.scope.title}</h2><p class="section-intro">{t.scope.intro}</p></div>
          </div>
          <div class="scope-grid">
            {t.scope.cards.map((card, index) => (
              <article class:list={["scope-card", index === 0 ? "scope-card-primary" : ""]}><p class="card-eyebrow">{card.label}</p><div class="scope-value">{card.value}</div><h3>{card.title}</h3><p>{card.body}</p></article>
            ))}
          </div>
          <div class="next-steps-grid">
            <article class="next-steps-card"><div class="subsection-heading"><h3>{t.scope.nextTitle}</h3><span>01—04</span></div><ol>{t.scope.nextSteps.map((step) => <li>{step}</li>)}</ol></article>
            <article class="risks-card"><div class="subsection-heading"><h3>{t.scope.risksTitle}</h3><span>WATCHLIST</span></div>{t.scope.risks.map((risk) => <div class="risk-item"><strong>{risk.label}</strong><p>{risk.body}</p></div>)}</article>
          </div>
        </section>

        <footer class="deck-footer">
          <div class="footer-main"><p class="eyebrow">{t.footer.eyebrow}</p><h2>{t.footer.title}</h2><p>{t.footer.body}</p><span class="footer-rule"></span><strong>{t.footer.close}</strong></div>
          <div class="footer-details">
            <div><span>{t.footer.teamLabel}</span><p>Nazım <small>— {lang === "tr" ? "Teknik" : "Technical"}</small></p><p>Ramtin <small>— {lang === "tr" ? "Sanat" : "Art"}</small></p></div>
            <div><span>{t.footer.toolsLabel}</span><p>Unity · Blender · VS Code</p><p>GitHub · Notion</p></div>
            <div><span>{t.footer.sourcesLabel}</span><p>{t.footer.sourceNote}</p><a href="https://store.steampowered.com/app/3431040/Thats_not_my_Neighbor/" target="_blank" rel="noreferrer">That's Not My Neighbor</a><a href="https://store.steampowered.com/app/239030/Papers_Please/" target="_blank" rel="noreferrer">Papers, Please</a><a href="https://store.steampowered.com/app/756800/Border_Officer/" target="_blank" rel="noreferrer">Contraband Police</a><a href="https://store.steampowered.com/app/1046820/" target="_blank" rel="noreferrer">I'm on Observation Duty</a><a href="https://store.steampowered.com/app/1771980/The_Operator/" target="_blank" rel="noreferrer">The Operator</a></div>
          </div>
        </footer>
      </div>
    </div>
  ))}
</div>

<script>
  const presentation = document.querySelector('[data-project-presentation]');
  if (presentation) {
    const panels = Array.from(presentation.querySelectorAll<HTMLElement>('[data-language-panel]'));
    const toggles = Array.from(presentation.querySelectorAll<HTMLButtonElement>('[data-language-toggle]'));
    const topCopies = Array.from(presentation.querySelectorAll<HTMLElement>('[data-top-copy]'));
    const topMetas = Array.from(presentation.querySelectorAll<HTMLElement>('[data-top-meta]'));
    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const language = toggle.getAttribute('data-language-toggle');
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-language-panel') !== language;
        });
        topCopies.forEach((item) => {
          item.hidden = item.getAttribute('data-top-copy') !== language;
        });
        topMetas.forEach((item) => {
          item.hidden = item.getAttribute('data-top-meta') !== language;
        });
        toggles.forEach((button) => {
          button.setAttribute('aria-pressed', String(button === toggle));
        });
        presentation.setAttribute('data-active-language', language || 'tr');
      });
    });
  }
</script>

<style>
  .nightwatch-presentation {
    --nw-ink: var(--color-text, #202321);
    --nw-muted: var(--color-muted, #777b76);
    --nw-line: var(--color-border, #d9dcd6);
    --nw-paper: var(--color-background, #f8f8f5);
    --nw-panel: var(--color-surface, #f0f1ec);
    --nw-dark: #202723;
    --nw-accent: #a8c0a7;
    color: var(--nw-ink);
    background: var(--nw-paper);
    font-family: inherit;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
  }

  .nightwatch-presentation * { box-sizing: border-box; }
  .nightwatch-presentation [hidden] { display: none !important; }
  .presentation-bar { max-width: 1240px; margin: 0 auto; padding: 18px clamp(18px, 4vw, 48px); display: flex; justify-content: space-between; align-items: center; gap: 18px; border-bottom: 1px solid var(--nw-line); }
  .presentation-brand { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; text-transform: uppercase; letter-spacing: .09em; font-size: 10px; font-weight: 650; }
  .brand-dot { width: 7px; height: 7px; border-radius: 50%; background: #8ca48c; display: inline-block; box-shadow: 0 0 0 3px color-mix(in srgb, #8ca48c 18%, transparent); }
  .bar-divider { color: var(--nw-muted); }
  .bar-meta { color: var(--nw-muted); font-weight: 500; }
