        { label: "GROUND FLOOR", body: "Security/inspection room, central observation area, airlock, and locked archive." },
        { label: "UPPER FLOOR", body: "Containment sector, security bridge, gate, and six containment cells." },
        { label: "BASEMENT", body: "Technical areas and connections for testing the facility maintenance flow." }
      ],
      mapNote: "Ramps, doors, collision geometry, and TextMesh labels make the space navigable and testable. The generator works in an isolated coordinate region to protect existing scene objects; this is a level-prototyping output, not final environment art.",
      architectureTitle: "Technical architecture & integration",
      architecture: [
        { title: "Core & time", body: "TimeManager maintains the shift flow; CheckpointManager and NPCController connect the facility lifecycle." },
        { title: "Deduction systems", body: "ScientistSystem, ScientistComponent, ScientistDataSO, and SkinwalkerComponent separate data, memory, and consistency checks." },
        { title: "Player & input", body: "PlayerInteraction, PlayerItemHolder, and PlayerWeaponHandler handle gameplay input; UI guards manage transitions." },
        { title: "Presentation", body: "ScientistDialogueUI, PauseMenuUI, PlayerHUD, and ShiftReportUI manage player-facing presentation." },
        { title: "World feedback", body: "FacilityLightingEffects and AudioManager produce lighting and audio feedback for events." },
        { title: "Level prototype", body: "FacilityMapBuilder and FacilityMapEditor generate the procedural facility blockout." }
      ],
      validationTitle: "Validation & engineering quality",
      validation: "The reported command `dotnet build \"Assembly-CSharp.csproj\" --no-restore` completed with zero compilation errors. This is a C# project compilation check; it is not a complete Unity Play Mode test, regression suite, performance test, or release build validation. Unity 6-compatible APIs replaced older APIs that had become obsolete.",
      statusTitle: "Current state & next direction",
      status: [
        { label: "REPORTED COMPLETE", value: "PHASE 12—19", body: "Technical systems and tools are reported as implemented; the complete final game is not claimed." },
        { label: "BLOCKOUT", value: "FACILITY MAP", body: "The procedural output is a testable architectural prototype, not final environment art." },
        { label: "NEXT FOCUS", value: "MAIN SCENE", body: "Player-facing UI, interaction polish, feedback, and campaign reliability." },
        { label: "QUALITY", value: "VERIFY & TEST", body: "Integration, usability, and gameplay flow require broader validation." }
      ]
    },
    scope: {
      tag: "SCOPE / DELIVERY TARGET",
      title: "Separate the course target from the long-term vision",
      intro: "The project aims for a longer demo, but the course submission should first deliver a small, complete, and representative playable section.",
      cards: [
        { label: "COURSE SUBMISSION", value: "10–30 minutes", title: "Playable vertical slice", body: "A short experience that demonstrates the core hook, gameplay loop, feedback, and a controlled rise in tension." },
        { label: "LONG-TERM TARGET", value: "3–4 hours", title: "Expanded demo", body: "More shifts, events, and content; treated as an ambition to revisit as scope and production capacity are validated." }
      ],
      nextTitle: "Next milestone",
      nextSteps: [
        "Test identity, memory, UV, tasks, shift flow, and creature mechanics in one representative sequence.",
        "Keep a short recording or test note for each scenario.",
        "Fix the highest-priority integration issues and review the prototype flow from a player's perspective.",
        "Lock the 10–30 minute vertical slice scope for the course; keep longer-term features in a separate backlog."
      ],
      risksTitle: "Scope risks to watch",
      risks: [
        { label: "Too many systems", body: "Response: validate the core flow first and attach additional features to milestones." },
        { label: "Integration complexity", body: "Response: test systems in isolation and with combined Sandbox scenarios." },
        { label: "Limited polish time", body: "Response: keep the course vertical slice separate from the long-term demo scope." }
      ]
    },
    footer: {
      eyebrow: "CURRENT STATUS",
      title: "From a concept to a testable gameplay loop.",
      body: "The first four weeks focus on explaining the idea, reviewing design references, defining the production method, and clearly showing which mechanics the current prototype can demonstrate.",
      teamLabel: "TEAM",
      toolsLabel: "TOOLS",
      sourcesLabel: "COMPETITOR SOURCES",
      sourceNote: "Game descriptions link to official Steam store pages. The comparisons are qualitative design analysis for this project.",
      close: "PROJECT: NIGHTWATCH · WORK IN PROGRESS"
    }
  }
};
const versions = Object.entries(copy);
---

<div class="nightwatch-presentation" data-project-presentation data-active-language={initialLanguage}>
  <section class="presentation-index" aria-labelledby="presentation-index-title">
    <div class="presentation-index-heading">
      <p class="eyebrow" id="presentation-index-title">{initialLanguage === "tr" ? "SUNUM ARŞİVİ" : "PRESENTATION ARCHIVE"}</p>
      <p>{initialLanguage === "tr" ? "Haftalara ayrı ayrı ulaş." : "Jump to each week separately."}</p>
    </div>
    <div class="presentation-index-grid">
      <a href={`#concept-${initialLanguage}`} data-presentation-link="concept">
        <span>01</span>
        <strong>{initialLanguage === "tr" ? "Konsept" : "Concept"}</strong>
        <small>{initialLanguage === "tr" ? "Hafta 01" : "Week 01"}</small>
      </a>
      <a href={`#market-${initialLanguage}`} data-presentation-link="market">
        <span>02</span>
        <strong>{initialLanguage === "tr" ? "Pazar araştırması" : "Market research"}</strong>
        <small>{initialLanguage === "tr" ? "Hafta 02" : "Week 02"}</small>
      </a>
      <a href={`#pipeline-${initialLanguage}`} data-presentation-link="pipeline">
        <span>03</span>
        <strong>{initialLanguage === "tr" ? "Üretim hattı" : "Production pipeline"}</strong>
        <small>{initialLanguage === "tr" ? "Hafta 03" : "Week 03"}</small>
      </a>
      <a href={`#prototype-${initialLanguage}`} data-presentation-link="prototype">
        <span>04</span>
        <strong>{initialLanguage === "tr" ? "Prototip ve test" : "Prototype & test"}</strong>
        <small>{initialLanguage === "tr" ? "Hafta 04" : "Week 04"}</small>
      </a>
      <a href={`#week5-${initialLanguage}`} data-presentation-link="week5">
        <span>05</span>
        <strong>{initialLanguage === "tr" ? "Hafta 05 sunumu" : "Week 05 presentation"}</strong>
        <small>{initialLanguage === "tr" ? "Core loop & game feel ↘" : "Core loop & game feel ↘"}</small>
      </a>
      <a href={`#engineering-${initialLanguage}`} data-presentation-link="engineering">
        <span>06</span>
        <strong>{initialLanguage === "tr" ? "Teknik ilerleme" : "Technical progress"}</strong>
        <small>{initialLanguage === "tr" ? "Phase 12—19 ↘" : "Phase 12—19 ↘"}</small>
      </a>
    </div>
    <a class="build-download" href="/downloads/hafta-06-build.zip" download="hafta-06-build.zip">
      <span class="build-download-index">06 / BUILD</span>
      <span class="build-download-copy">
        <strong>{initialLanguage === "tr" ? "Hafta 6 build'ini indir" : "Download the Week 6 build"}</strong>
        <small>{initialLanguage === "tr" ? "Project: Nightwatch · ZIP arşivi" : "Project: Nightwatch · ZIP archive"}</small>
      </span>
      <span class="build-download-arrow" aria-hidden="true">↓</span>
    </a>
  </section>
  <div class="presentation-bar">
    <div class="presentation-brand">
      <span class="brand-dot" aria-hidden="true"></span>
      <span data-top-copy="tr" hidden={initialLanguage !== "tr"}>{copy.tr.topLabel}</span>
      <span data-top-copy="en" hidden={initialLanguage !== "en"}>{copy.en.topLabel}</span>
      <span class="bar-divider">/</span>
      <span class="bar-meta" data-top-meta="tr" hidden={initialLanguage !== "tr"}>{copy.tr.topMeta}</span>
      <span class="bar-meta" data-top-meta="en" hidden={initialLanguage !== "en"}>{copy.en.topMeta}</span>
    </div>
    <div class="language-control" role="group" aria-label="Presentation language">
      <button type="button" data-language-toggle="tr" aria-pressed={initialLanguage === "tr"}>TR</button>
      <button type="button" data-language-toggle="en" aria-pressed={initialLanguage === "en"}>EN</button>
    </div>
  </div>

  {versions.map(([lang, t]) => (
    <div class="deck-language" data-language-panel={lang} lang={lang} hidden={lang !== initialLanguage}>
      <div class="deck-container">
        <header class="deck-hero">
          <div class="hero-copy">
            <p class="eyebrow"><span>{t.heroKicker}</span><span class="eyebrow-line"></span></p>
            <h1>{t.heroTitle}</h1>
            <p class="hero-subtitle">{t.heroSubtitle}</p>
            <p class="hero-body">{t.heroBody}</p>
            <div class="hero-status"><span class="status-dot"></span>{t.status}</div>
            <div class="hero-meta-grid">
              {t.heroMeta.map((item) => (
                <div class="hero-meta-item">
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </div>
              ))}
            </div>
          </div>
          <aside class="facility-card" aria-label={t.facilityEyebrow}>
            <div class="facility-card-head">
              <div><p>{t.facilityEyebrow}</p><strong>{t.facilityHeader}</strong></div>
              <span class="facility-indicator"><i></i> {t.facilityStatus}</span>
            </div>
            <div class="facility-schematic">
              {t.facility.map((room, index) => (
                <div class:list={["facility-zone", index === 4 ? "zone-booth" : "", index === 0 ? "zone-restricted" : ""]}>
                  <span class="zone-index">0{index + 1}</span>
                  <span class="zone-name">{room}</span>
                  <span class="zone-mark" aria-hidden="true">{index === 0 ? "×" : index === 4 ? "↔" : "·"}</span>
                </div>
              ))}
            </div>
            <p class="facility-foot"><span>↳</span> {t.facilityFoot}</p>
            <div class="facility-card-bottom"><span>21:00</span><span class="timeline"><i></i></span><span>09:00</span></div>
          </aside>
        </header>

        <div class="presentation-intro">
          <div class="intro-index">00</div>
          <div>
            <h2>{t.introTitle}</h2>
            <p>{t.introBody}</p>
          </div>
        </div>

        <section class="fact-grid" aria-label="Project summary">
          {t.factCards.map((card, index) => (
            <article class="fact-card">
              <div class="fact-card-top"><span>0{index + 1}</span><span class="fact-arrow">↗</span></div>
              <p class="card-eyebrow">{card.label}</p>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))}
        </section>

        <nav class="section-toc" aria-label={t.navLabel}>
          <span class="toc-label">{t.tocTitle}</span>
          <div class="toc-links">
            {t.toc.map((item) => (
              <a href={`#${item.id}-${lang}`}>{item.label}<span aria-hidden="true"> ↘</span></a>
            ))}
          </div>
        </nav>

        <section class="deck-section" id={`concept-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week1.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week1.tag}</p><h2>{t.week1.title}</h2><p class="section-intro">{t.week1.intro}</p></div>
          </div>
          <div class="concept-pitch">
            <div class="pitch-label"><span class="small-square"></span>{t.week1.pitchLabel}</div>
            <p>{t.week1.pitch}</p>
            <span class="pitch-decoration" aria-hidden="true">“</span>
          </div>
          <div class="subsection-heading"><h3>{t.week1.pillarsTitle}</h3><span>01—03</span></div>
          <div class="pillar-grid">
            {t.week1.pillars.map((pillar) => (
              <article class="pillar-card">
                <span class="pillar-number">{pillar.number}</span>
                <h4>{pillar.title}</h4>
                <p>{pillar.body}</p>
              </article>
            ))}
          </div>
          <div class="loop-block">
            <div class="subsection-heading"><h3>{t.week1.loopTitle}</h3><span>CORE LOOP</span></div>
            <div class="loop-flow">
              {t.week1.loop.map((step, index) => (
                <div class="loop-step"><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong>{index < t.week1.loop.length - 1 && <i aria-hidden="true">→</i>}</div>
              ))}
            </div>
          </div>
          <aside class="editorial-note"><span class="note-mark">i</span><div><h3>{t.week1.noteTitle}</h3><p>{t.week1.note}</p></div></aside>
        </section>

        <section class="deck-section" id={`market-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week2.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week2.tag}</p><h2>{t.week2.title}</h2><p class="section-intro">{t.week2.intro}</p></div>
          </div>
          <div class="market-summary-grid">
            <article class="market-summary"><span class="market-icon">◎</span><div><h3>{t.week2.audienceTitle}</h3><p>{t.week2.audience}</p></div></article>
            <article class="market-summary market-summary-dark"><span class="market-icon">✳</span><div><h3>{t.week2.uspTitle}</h3><p>{t.week2.usp}</p></div></article>
          </div>
          <div class="subsection-heading competitor-heading"><h3>{t.week2.competitorTitle}</h3><span>05 REFERENCES</span></div>
          <p class="section-intro competitor-intro">{t.week2.competitorIntro}</p>
          <div class="competitor-list">
            {t.week2.competitors.map((game, index) => (
              <article class="competitor-row">
                <div class="competitor-index">0{index + 1}</div>
                <div class="competitor-main"><div class="competitor-titleline"><h3>{game.name}</h3><span>{game.lens}</span></div><p class="competitor-strength">{game.strength}</p><p class="competitor-opportunity"><strong>{lang === "tr" ? "Tasarım fırsatı" : "Design opportunity"}</strong>{game.opportunity}</p></div>
                <a class="external-link" href={game.url} target="_blank" rel="noreferrer">{lang === "tr" ? "Resmî sayfa" : "Official page"}<span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
          <p class="source-note"><span>*</span> {t.week2.researchNote}</p>
        </section>

        <section class="deck-section" id={`pipeline-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week3.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week3.tag}</p><h2>{t.week3.title}</h2><p class="section-intro">{t.week3.intro}</p></div>
          </div>
          <div class="tools-block">
            <div class="subsection-heading"><h3>{t.week3.toolsTitle}</h3><span>TOOLKIT</span></div>
            <div class="tool-grid">
              {t.week3.tools.map((tool) => (
                <article class="tool-card"><span class="tool-mark">↗</span><h4>{tool.name}</h4><p>{tool.role}</p></article>
              ))}
            </div>
          </div>
          <div class="roles-block">
            <div class="subsection-heading"><h3>{t.week3.rolesTitle}</h3><span>TEAM / 02</span></div>
            <div class="role-grid">
              {t.week3.roles.map((role) => (
                <article class="role-card"><p class="card-eyebrow">{role.role}</p><h3>{role.person}</h3><p>{role.body}</p></article>
              ))}
            </div>
          </div>
          <div class="flow-block">
            <div class="subsection-heading"><h3>{t.week3.flowTitle}</h3><span>PIPELINE</span></div>
            <div class="production-flow">
              {t.week3.flow.map((phase) => (
                <article class="production-phase"><span>{phase.number}</span><div><h4>{phase.title}</h4><p>{phase.body}</p></div></article>
              ))}
            </div>
          </div>
          <div class="pipeline-bottom-grid">
            <article class="principles-card"><div class="subsection-heading"><h3>{t.week3.rulesTitle}</h3><span>RULES</span></div><ul>{t.week3.rules.map((rule) => <li>{rule}</li>)}</ul></article>
            <aside class="current-stage-card"><span class="card-eyebrow">{t.week3.currentStageTitle}</span><div class="stage-mark"><span>PHASE</span><strong>10</strong></div><p>{t.week3.currentStage}</p></aside>
          </div>
        </section>

        <section class="deck-section prototype-section" id={`prototype-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week4.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week4.tag}</p><h2>{t.week4.title}</h2><p class="section-intro">{t.week4.intro}</p></div>
          </div>
          <div class="prototype-status-line"><span class="live-dot"></span><strong>{t.week4.implementationLabel}</strong><span class="status-chip">DEBUG BUILD</span></div>
          <p class="prototype-disclaimer">{t.week4.implementationNote}</p>
          <div class="feature-grid">
            {t.week4.features.map((feature, index) => (
              <article class="feature-card"><div class="feature-card-head"><span>0{index + 1}</span><span class="feature-check">✓</span></div><h3>{feature.title}</h3><p>{feature.body}</p><span class="feature-state">{lang === "tr" ? "PROTOTİPTE VAR" : "IN PROTOTYPE"}</span></article>
            ))}
          </div>
          <div class="test-plan-block">
            <div class="subsection-heading"><h3>{t.week4.testTitle}</h3><span>QA / PROTOTYPE</span></div>
            <p class="section-intro">{t.week4.testIntro}</p>
            <div class="test-grid">
              {t.week4.tests.map((test) => (
                <article class="test-card"><div class="test-card-top"><span>{test.number}</span><span class="test-circle">○</span></div><h3>{test.title}</h3><div class="test-field"><span>{lang === "tr" ? "AKIŞ" : "FLOW"}</span><p>{test.steps}</p></div><div class="test-field expected"><span>{lang === "tr" ? "BEKLENEN" : "EXPECTED"}</span><p>{test.expected}</p></div></article>
              ))}
            </div>
          </div>
          <aside class="editorial-note"><span class="note-mark">↗</span><div><h3>{t.week4.demoNoteTitle}</h3><p>{t.week4.demoNote}</p></div></aside>
        </section>

        <section class="deck-section week5-section" id={`week5-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.week5.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.week5.tag}</p><h2>{t.week5.title}</h2><p class="section-intro">{t.week5.intro}</p></div>
          </div>
          <div class="week5-milestone">
            <div><p class="card-eyebrow">{t.week5.milestoneTitle}</p><div class="stage-mark"><span>PHASE</span><strong>11</strong></div></div>
            <p>{t.week5.milestone}</p>
          </div>
          <div class="subsection-heading"><h3>{t.week5.loopTitle}</h3><span>CORE LOOP / 05</span></div>
          <div class="week5-loop">
            {t.week5.loop.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}
          </div>
          <div class="subsection-heading"><h3>{t.week5.integrationTitle}</h3><span>PHASE 11</span></div>
          <div class="production-flow week5-integration">
            {t.week5.integration.map((step) => <article class="production-phase"><span>{step.number}</span><div><h4>{step.title}</h4><p>{step.body}</p></div></article>)}
          </div>
          <div class="subsection-heading"><h3>{t.week5.artTitle}</h3><span>ART / WIP</span></div>
          <p class="section-intro week5-art-intro">{t.week5.artIntro}</p>
          <div class="role-grid week5-art-grid">
            {t.week5.artCards.map((card) => <article class="role-card"><p class="card-eyebrow">WORK IN PROGRESS</p><h3>{card.title}</h3><p>{card.body}</p></article>)}
          </div>
          <div class="prototype-status-line"><span class="live-dot"></span><strong>{t.week5.prototypeTitle}</strong><span class="status-chip">SANDBOX / INTEGRATED</span></div>
          <p class="prototype-disclaimer">{t.week5.prototypeNote}</p>
          <div class="feature-grid week5-system-grid">
            {t.week5.systems.map((system, index) => <article class="feature-card"><div class="feature-card-head"><span>0{index + 1}</span><span class="feature-check">✓</span></div><h3>{system}</h3><span class="feature-state">{lang === "tr" ? "SANDBOX'TA VAR" : "IN SANDBOX"}</span></article>)}
          </div>
          <div class="week5-bottom-grid">
            <article class="next-steps-card"><div class="subsection-heading"><h3>{t.week5.objectiveTitle}</h3><span>PLAYABLE SEQUENCE</span></div><ol>{t.week5.objectives.map((objective) => <li>{objective}</li>)}</ol></article>
            <article class="risks-card"><div class="subsection-heading"><h3>{t.week5.feelTitle}</h3><span>CHECKLIST</span></div>{t.week5.feel.map((item) => <div class="risk-item"><strong>{item.title}</strong><p>{item.body}</p></div>)}</article>
          </div>
          <div class="week5-status-grid">
            {t.week5.status.map((item) => <article><span>{item.label}</span><strong>{item.value}</strong><p>{item.body}</p></article>)}
          </div>
        </section>

        <section class="deck-section engineering-section" id={`engineering-${lang}`}>
          <div class="section-heading">
            <div class="section-number">{t.engineering.number}</div>
            <div class="section-heading-main"><p class="eyebrow">{t.engineering.tag}</p><h2>{t.engineering.title}</h2><p class="section-intro">{t.engineering.intro}</p></div>
          </div>
          <div class="engineering-overview"><p>{t.engineering.overview}</p></div>
          <div class="subsection-heading"><h3>{t.engineering.milestonesTitle}</h3><span>12—19</span></div>
          <div class="engineering-milestones">
            {t.engineering.milestones.map((milestone) => <article><span>{milestone.phase}</span><h3>{milestone.title}</h3><p>{milestone.body}</p></article>)}
          </div>
          <div class="engineering-two-column">
            <article class="engineering-panel">
              <div class="subsection-heading"><h3>{t.engineering.dialogueTitle}</h3><span>UI / MEMORY</span></div>
              <p class="section-intro">{t.engineering.dialogueIntro}</p>
              <ul>{t.engineering.dialoguePoints.map((point) => <li>{point}</li>)}</ul>
            </article>
            <article class="engineering-panel">
              <div class="subsection-heading"><h3>{t.engineering.lifecycleTitle}</h3><span>NPC / EXIT</span></div>
              <p class="section-intro">{t.engineering.lifecycleIntro}</p>
              <ol>{t.engineering.lifecycle.map((step) => <li>{step}</li>)}</ol>
            </article>
          </div>
          <div class="engineering-two-column">
            <article class="engineering-panel">
              <div class="subsection-heading"><h3>{t.engineering.inputTitle}</h3><span>INPUT / UI</span></div>
              <p class="section-intro">{t.engineering.inputIntro}</p>
              <ul>{t.engineering.inputPoints.map((point) => <li>{point}</li>)}</ul>
            </article>
            <article class="engineering-panel map-panel">
              <div class="subsection-heading"><h3>{t.engineering.mapTitle}</h3><span>LEVEL / BLOCKOUT</span></div>
              <p class="section-intro">{t.engineering.mapIntro}</p>
              <div class="map-zones">{t.engineering.mapZones.map((zone) => <div><strong>{zone.label}</strong><p>{zone.body}</p></div>)}</div>
              <p class="source-note"><span>*</span> {t.engineering.mapNote}</p>
            </article>
          </div>
          <div class="subsection-heading"><h3>{t.engineering.architectureTitle}</h3><span>DEPENDENCY MAP</span></div>
          <div class="architecture-grid">
            {t.engineering.architecture.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}
          </div>
          <div class="engineering-validation">
            <div><div class="subsection-heading"><h3>{t.engineering.validationTitle}</h3><span>BUILD CHECK</span></div><p>{t.engineering.validation}</p></div>
            <div class="validation-command"><span>COMMAND</span><code>dotnet build "Assembly-CSharp.csproj" --no-restore</code><strong>0 compilation errors</strong></div>
          </div>
          <div class="subsection-heading"><h3>{t.engineering.statusTitle}</h3><span>STATUS / NEXT</span></div>
          <div class="engineering-status-grid">
