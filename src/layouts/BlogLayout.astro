---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith('/en/');
const projectPath = isEnglish ? '/en/projects/celltest-positive' : '/projects/celltest-positive';
---

<BaseLayout
  title={`${frontmatter.title} | TheosDev`}
  description={frontmatter.summary}
  lang={isEnglish ? 'en' : 'tr'}
>
  <article class="article-wrap">
    <a class="detail-back" href={projectPath}>← {isEnglish ? 'Back to project' : 'Projeye dön'}</a>
    <header class="article-header">
      <p class="eyebrow">TheosDev / {isEnglish ? 'Writing' : 'Yazı'}</p>
      <h1 class="page-title">{frontmatter.title}</h1>
      <div class="article-meta">
        <span>{frontmatter.date}</span>
        <span>{frontmatter.author}</span>
      </div>
    </header>
    <div class="article-prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article-wrap { margin: 0 auto; max-width: 900px; padding: 52px 28px 110px; }
  .article-header { border-bottom: 1px solid var(--line); padding: 78px 0 46px; }
  .article-header .page-title { max-width: 820px; }
  .article-meta { color: var(--muted); display: flex; font-size: 0.8rem; gap: 18px; }
  .article-meta span + span::before { color: var(--line); content: '/'; margin-right: 18px; }
  .article-prose { max-width: 720px; padding-top: 44px; }
  .article-prose :global(h1), .article-prose :global(h2), .article-prose :global(h3) { color: var(--ink); font-family: Georgia, "Times New Roman", serif; font-weight: 400; line-height: 1.1; margin: 48px 0 18px; }
  .article-prose :global(h1) { font-size: 2.35rem; }
  .article-prose :global(h2) { border-top: 1px solid var(--line); font-size: 1.85rem; padding-top: 22px; }
  .article-prose :global(h3) { font-size: 1.35rem; }
  .article-prose :global(p), .article-prose :global(li) { color: var(--ink-soft); font-size: 1.08rem; line-height: 1.85; }
  .article-prose :global(ul), .article-prose :global(ol) { padding-left: 24px; }
  .article-prose :global(li) { margin-bottom: 9px; }
  .article-prose :global(code) { background: #e8e3d9; color: var(--accent-dark); font-family: Consolas, monospace; font-size: 0.9em; padding: 3px 6px; }
  .article-prose :global(pre) { background: var(--ink); color: var(--paper-bright); overflow-x: auto; padding: 20px; }

  @media (max-width: 680px) {
    .article-wrap { padding: 36px 20px 72px; }
    .article-header { padding-top: 60px; }
    .article-prose :global(p), .article-prose :global(li) { font-size: 1rem; }
  }
</style>
