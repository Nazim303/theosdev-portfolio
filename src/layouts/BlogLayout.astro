---
// Markdown dosyasının en üstündeki (---) değişkenleri (title, date vb.) içeri alır
const { frontmatter } = Astro.props;
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | TheosDev</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
    <style>
      body {
        background-color: #0f1115;
        color: #e2e8f0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
        margin: 0;
        padding: 0;
      }
      .blog-container {
        max-width: 800px; /* Okumayı kolaylaştırmak için blog sayfası daha dardır */
        margin: 0 auto;
        padding: 80px 20px;
        opacity: 0; /* GSAP animasyonu için */
      }
      .back-btn {
        display: inline-block;
        color: #00e676;
        text-decoration: none;
        font-weight: bold;
        margin-bottom: 40px;
        transition: transform 0.2s;
      }
      .back-btn:hover { transform: translateX(-5px); }
      
      /* Blog Üst Bilgileri (Künye) */
      .blog-header {
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 20px;
        margin-bottom: 40px;
      }
      .blog-header h1 {
        color: #f8fafc;
        font-size: 2.5rem;
        margin: 0 0 10px 0;
        line-height: 1.2;
      }
      .blog-meta {
        color: #94a3b8;
        font-size: 0.9rem;
      }

      /* Markdown Metin (Prose) Otomatik Stilleri */
      .prose h1, .prose h2, .prose h3 {
        color: #00e676;
        margin-top: 40px;
        margin-bottom: 20px;
      }
      .prose p {
        margin-bottom: 20px;
        color: #cbd5e1;
        font-size: 1.1rem;
      }
      .prose ul, .prose ol {
        margin-bottom: 20px;
        padding-left: 20px;
        color: #cbd5e1;
        font-size: 1.1rem;
      }
      .prose li {
        margin-bottom: 10px;
      }
      /* Markdown içindeki `kod` blokları */
      .prose code {
        background: rgba(255, 255, 255, 0.1);
        color: #00e676;
        padding: 3px 6px;
        border-radius: 4px;
        font-family: 'Courier New', Courier, monospace;
        font-size: 0.9em;
      }
    </style>
  </head>
  <body>
    
    <div class="blog-container anim-blog">
      <a href="/projects/celltest-positive" class="back-btn">← Projeye Dön</a>
      
      <!-- Başlık ve Meta Veriler (Markdown'dan otomatik çekilir) -->
      <div class="blog-header">
        <h1>{frontmatter.title}</h1>
        <div class="blog-meta">
          Tarih: {frontmatter.date} | Yazar: {frontmatter.author}
        </div>
      </div>

      <!-- Markdown içindeki saf metin tam olarak bu <slot /> etiketinin içine dökülür -->
      <div class="prose">
        <slot />
      </div>
    </div>

    <!-- Yumuşak Giriş Animasyonu -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        gsap.to(".anim-blog", { opacity: 1, y: -20, duration: 1, ease: "power3.out" });
      });
    </script>
  </body>
</html>