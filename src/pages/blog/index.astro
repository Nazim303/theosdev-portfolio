---
const allPosts = Object.values(import.meta.glob('./*.md', { eager: true }));

// Tarihe göre sırala
allPosts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

// Sabitlenmiş ve Normal Yazıları Ayır
const pinnedPosts = allPosts.filter(post => post.frontmatter.pinned === true);
const regularPosts = allPosts.filter(post => !post.frontmatter.pinned);

const pageTitle = "Devlog & Yazılar | TheosDev";
---

<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
    <style>
      body { background-color: #0f1115; color: #e2e8f0; font-family: 'Segoe UI', Tahoma, sans-serif; margin: 0; padding: 0; }
      .container { max-width: 1000px; margin: 0 auto; padding: 60px 20px; }
      .back-btn { display: inline-block; color: #00e676; text-decoration: none; font-weight: bold; margin-bottom: 30px; transition: transform 0.2s; }
      .back-btn:hover { transform: translateX(-5px); }
      
      h1 { font-size: 3rem; color: #f8fafc; margin-bottom: 40px; }
      h2.section-subtitle { color: #94a3b8; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 1px; margin-top: 40px; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 8px; }

      .blog-list { display: flex; flex-direction: column; gap: 20px; }

      /* Kart Tasarımları */
      .blog-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 4px solid #00e676;
        border-radius: 8px;
        padding: 24px;
        text-decoration: none;
        color: inherit;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s;
      }

      /* Sabitlenmiş Kart Stili */
      .blog-card.pinned {
        background: linear-gradient(145deg, rgba(0, 230, 118, 0.08), rgba(15, 17, 21, 0.95));
        border: 1px solid #00e676;
        border-left: 6px solid #00e676;
        box-shadow: 0 10px 30px -10px rgba(0, 230, 118, 0.2);
      }

      .blog-card:hover { transform: translateX(10px); background: rgba(0, 230, 118, 0.05); }
      .blog-info h3 { margin: 8px 0; color: #f8fafc; font-size: 1.5rem; }
      .blog-summary { color: #94a3b8; font-size: 0.95rem; margin-bottom: 12px; }
      .blog-meta { color: #64748b; font-size: 0.85rem; }
      .blog-meta span { color: #00e676; font-weight: bold; }
      
      .pinned-badge {
        display: inline-block;
        background: #00e676;
        color: #0f1115;
        font-size: 0.75rem;
        font-weight: bold;
        padding: 3px 8px;
        border-radius: 4px;
        text-transform: uppercase;
      }

      .read-more {
        background: rgba(0, 230, 118, 0.1);
        color: #00e676;
        padding: 10px 20px;
        border-radius: 6px;
        font-weight: bold;
        white-space: nowrap;
      }
    </style>
  </head>
  <body>

    <div class="container">
      <a href="/" class="back-btn">← Ana Sayfaya Dön</a>
      <h1 class="anim-header">Geliştirici Günlükleri (Devlogs)</h1>

      <!-- SABİTLENMİŞ YAZILAR BÖLÜMÜ -->
      {pinnedPosts.length > 0 && (
        <div>
          <h2 class="section-subtitle">📌 Sabitlenmiş Öne Çıkanlar</h2>
          <div class="blog-list">
            {pinnedPosts.map((post) => (
              <a href={post.url} class="blog-card pinned anim-card">
                <div class="blog-info">
                  <span class="pinned-badge">SABİTLENDİ</span>
                  <h3>{post.frontmatter.title}</h3>
                  {post.frontmatter.summary && <p class="blog-summary">{post.frontmatter.summary}</p>}
                  <div class="blog-meta">
                    Tarih: <span>{post.frontmatter.date}</span> | Yazar: {post.frontmatter.author}
                  </div>
                </div>
                <div class="read-more">Devlog'u Oku ➜</div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- TÜM YAZILAR BÖLÜMÜ -->
      <h2 class="section-subtitle">Tüm Devloglar</h2>
      <div class="blog-list">
        {regularPosts.map((post) => (
          <a href={post.url} class="blog-card anim-card">
            <div class="blog-info">
              <h3>{post.frontmatter.title}</h3>
              {post.frontmatter.summary && <p class="blog-summary">{post.frontmatter.summary}</p>}
              <div class="blog-meta">
                Tarih: <span>{post.frontmatter.date}</span> | Yazar: {post.frontmatter.author}
              </div>
            </div>
            <div class="read-more">Yazıyı Oku ➜</div>
          </a>
        ))}
      </div>

    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        gsap.to(".anim-header", { opacity: 1, y: -20, duration: 0.8, ease: "power3.out" });
        gsap.fromTo(".anim-card", { opacity: 0, x: -20 }, { opacity: 1, x: 0, duration: 0.5, stagger: 0.15, delay: 0.3, ease: "power3.out" });
      });
    </script>
  </body>
</html>