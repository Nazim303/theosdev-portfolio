---
import ProjectCard from '../../components/ProjectCard.astro';
const pageTitle = "TheosDev | Game Programmer";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
    <style>
      body {
        background-color: #0f1115;
        color: #e2e8f0;
        font-family: 'Segoe UI', Tahoma, sans-serif;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }
      
      /* Language Switcher */
      .lang-switch { position: absolute; top: 24px; right: 24px; display: flex; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 30px; padding: 4px; z-index: 100; opacity: 0; }
      .lang-btn { padding: 6px 16px; border-radius: 20px; text-decoration: none; color: #94a3b8; font-size: 0.85rem; font-weight: bold; transition: all 0.3s ease; }
      .lang-btn.active { background: #00e676; color: #0f1115; }
      .lang-btn:hover:not(.active) { color: #f8fafc; }

      /* Hero */
      .hero-section { padding: 100px 20px 50px 20px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }
      h1 { font-size: 4rem; margin-bottom: 10px; color: #00e676; opacity: 0; }
      .hero-subtitle { font-size: 1.5rem; color: #94a3b8; opacity: 0; margin-bottom: 30px; }
      
      .link-tree { display: flex; gap: 15px; opacity: 0; }
      .link-btn { padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: bold; background: rgba(255, 255, 255, 0.1); color: #e2e8f0; transition: all 0.2s; border: 1px solid rgba(255,255,255,0.2); }
      .link-btn:hover { background: #00e676; color: #0f1115; border-color: #00e676; }

      .section-container { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }
      .section-title { font-size: 2rem; margin-bottom: 30px; color: #f8fafc; border-bottom: 2px solid rgba(0, 230, 118, 0.3); padding-bottom: 10px; display: inline-block; }

      /* About Me */
      .about-section { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 30px; border-radius: 12px; margin-bottom: 60px; line-height: 1.8; font-size: 1.1rem; opacity: 0;}
      .about-section span { color: #00e676; font-weight: bold; }

      /* Latest Updates */
      .update-card { background: linear-gradient(145deg, rgba(0, 230, 118, 0.1), rgba(15, 17, 21, 0.9)); border: 1px solid #00e676; border-radius: 12px; padding: 24px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; opacity: 0; }
      .update-tag { background: #00e676; color: #0f1115; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; margin-right: 15px;}
      .update-text { color: #f8fafc; font-size: 1.1rem; }
      .update-link { color: #00e676; text-decoration: none; font-weight: bold; }
      
      .project-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
      
      /* View All Button */
      .view-all-container { text-align: center; margin-top: 40px; margin-bottom: 60px; opacity: 0; }
      .view-all-btn { display: inline-block; padding: 12px 28px; background: transparent; color: #00e676; border: 1px solid #00e676; border-radius: 8px; text-decoration: none; font-weight: bold; transition: all 0.3s; }
      .view-all-btn:hover { background: #00e676; color: #0f1115; }
    </style>
  </head>
  <body>

    <div class="lang-switch anim-hero">
      <a href="/" class="lang-btn">TR</a>
      <a href="/en" class="lang-btn active">EN</a>
    </div>

    <section class="hero-section">
      <h1 class="anim-hero">TheosDev</h1>
      <p class="hero-subtitle anim-hero">Unity & C# Game Programmer</p>
      
      <div class="link-tree anim-hero">
        <a href="#" class="link-btn">GitHub</a>
        <a href="#" class="link-btn">Itch.io</a>
        <a href="#" class="link-btn">LinkedIn</a>
        <a href="#" class="link-btn">Resume (CV)</a>
      </div>
    </section>

    <div class="section-container">
      
      <!-- ABOUT ME SECTION -->
      <div class="about-section anim-update">
        <h2 class="section-title">About Me</h2>
        <p>Hello, I am <span>Nazım Beyaz</span>. Having completed the first two years of my four-year university degree, I am a Gameplay & Systems Programmer focused on building robust code architectures and rapid prototyping in game development processes.</p>
        <p>Taking an idea from paper and transforming it into a playable, scalable system is my biggest passion. With my experience in C# and the Unity engine, I develop multiplayer infrastructures, asymmetric network systems, state machine architectures, and custom editor tools. Over the next two years, I aim to build upon this foundation and produce engineering solutions that make a difference in the industry.</p>
      </div>

      <!-- LATEST UPDATES SECTION -->
      <h2 class="section-title">Latest Updates</h2>
      <div class="update-card anim-update">
        <div>
          <span class="update-tag">NEW POST</span>
          <span class="update-text">Devlog: Asymmetric Network Architecture for CELLTEST POSITIVE</span>
        </div>
        <a href="/en/blog/network-architecture" class="update-link">Read ➜</a>
      </div>
      
      <div class="view-all-container anim-update">
        <a href="/en/blog" class="view-all-btn">View All Devlogs & Articles</a>
      </div>

      <!-- FEATURED PROJECTS SHOWCASE -->
      <h2 class="section-title">Featured Projects</h2>
      <div class="project-grid">
        
        <ProjectCard 
          title="CELLTEST POSITIVE"
          description="1v1 online asymmetric strategy card game. Built on Host (Cancer) and Client (Antibody) architecture where players use their health pool as a resource."
          tags={["Unity", "Networking", "Asymmetric"]}
          link="/en/projects/celltest-positive" 
        />

        <ProjectCard 
          title="Eternal Debt: Grave Shift"
          description="Team-oriented Co-op survival game featuring Vivox voice chat integration. Includes custom abilities for Digger, Mage, and Carrier roles."
          tags={["C#", "Co-op", "Vivox", "Multiplayer"]}
          link="/en/projects/eternal-debt"
        />

        <ProjectCard 
          title="Story About Fall"
          description="Turn-based RPG combining roguelike dungeon progression with classic JRPG combat mechanics. Features companion evolution and Hub resource management."
          tags={["Turn-Based", "RPG", "State Machine"]}
          link="/en/projects/story-about-fall"
        />

        <ProjectCard 
          title="Craps With The Devil"
          description="Physics-based atmospheric gambling game depending on the force and angle of the dice. Features a dynamic risk/reward loop with dark magic mechanics."
          tags={["Physics", "Game Juice", "Atmospheric"]}
          link="/en/projects/craps-with-the-devil"
        />

      </div>

      <div class="view-all-container anim-update">
        <a href="/en/projects" class="view-all-btn">View All Projects (Archive)</a>
      </div>

    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        gsap.to(".anim-hero", { opacity: 1, y: -20, duration: 0.8, stagger: 0.2, ease: "power3.out" });
        gsap.to(".anim-update", { opacity: 1, x: 20, duration: 1, stagger: 0.2, delay: 0.6, ease: "power3.out" });
      });
    </script>
  </body>
</html>