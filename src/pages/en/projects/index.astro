---
const pageTitle = "All Projects & Archive | TheosDev";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" is:inline></script>
    <style>
      body { background-color: #0f1115; color: #e2e8f0; font-family: 'Segoe UI', Tahoma, sans-serif; margin: 0; padding: 0; }
      .container { max-width: 1200px; margin: 0 auto; padding: 60px 20px; }
      .back-btn { display: inline-block; color: #00e676; text-decoration: none; font-weight: bold; margin-bottom: 30px; transition: transform 0.2s; }
      .back-btn:hover { transform: translateX(-5px); }
      
      h1 { font-size: 3rem; color: #f8fafc; margin-bottom: 40px; }

      /* Filter Panel */
      .filter-panel {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 40px;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
      }
      .filter-group {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        min-width: 150px;
      }
      .filter-group label {
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 5px;
        font-weight: bold;
      }
      .filter-group select {
        background: rgba(15, 17, 21, 0.8);
        color: #e2e8f0;
        border: 1px solid rgba(0, 230, 118, 0.3);
        padding: 10px;
        border-radius: 6px;
        outline: none;
        cursor: pointer;
      }
      .filter-group select:focus { border-color: #00e676; }

      /* Project Grid & Cards */
      .project-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
      }
      
      .project-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s;
      }
      .project-card:hover {
        transform: translateY(-5px);
        border-color: #00e676;
        background: rgba(255, 255, 255, 0.05);
      }
      
      .project-card h3 { margin: 0 0 10px 0; color: #f8fafc; font-size: 1.4rem; }
      .project-card p { color: #94a3b8; font-size: 0.95rem; margin-bottom: 20px; flex-grow: 1; }
      
      .meta-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px; }
      .meta-tag { 
        font-size: 0.75rem; 
        padding: 4px 8px; 
        border-radius: 4px; 
        font-weight: bold; 
        background: rgba(255,255,255,0.1); 
      }
      .tag-lang { color: #38bdf8; }
      .tag-type { color: #fbbf24; }
      .tag-status { color: #10b981; }
    </style>
  </head>
  <body>

    <div class="container">
      <a href="/en" class="back-btn">← Back to Home</a>
      
      <h1 class="anim-header">Projects & Archive</h1>

      <!-- FILTER PANEL -->
      <div class="filter-panel anim-header">
        
        <div class="filter-group">
          <label>TYPE</label>
          <select id="filter-type">
            <option value="all">All</option>
            <option value="game">Game</option>
            <option value="toolkit">Toolkit / Utility</option>
            <option value="app">App</option>
            <option value="system">System / Universe</option>
          </select>
        </div>

        <div class="filter-group">
          <label>LANGUAGE & ENGINE</label>
          <select id="filter-lang">
            <option value="all">All</option>
            <option value="csharp">C# (Unity)</option>
            <option value="dart">Dart (Flutter)</option>
            <option value="lua">Luau (Roblox)</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="filter-group">
          <label>TEAM</label>
          <select id="filter-team">
            <option value="all">All</option>
            <option value="solo">Solo Developer</option>
            <option value="team">Team / Co-op</option>
          </select>
        </div>

        <div class="filter-group">
          <label>STATUS</label>
          <select id="filter-status">
            <option value="all">All</option>
            <option value="finished">Completed</option>
            <option value="wip">Work In Progress (WIP)</option>
            <option value="prototype">Prototype / Archive</option>
          </select>
        </div>

        <div class="filter-group">
          <label>PLATFORM</label>
          <select id="filter-platform">
            <option value="all">All</option>
            <option value="pc">PC (Windows)</option>
            <option value="web">Web (HTML5)</option>
            <option value="mobile">Mobile</option>
            <option value="multi">Cross-Platform</option>
          </select>
        </div>

      </div>

      <!-- PROJECTS LIST -->
      <div class="project-grid" id="project-container">

        <!-- 1. WORK TRACKER (İŞ TAKİP) -->
        <a href="/en/projects/is-takip" class="project-card" data-type="app" data-lang="dart" data-team="solo" data-status="wip" data-platform="mobile">
          <h3>Work Tracker (İş Takip)</h3>
          <p>Offline Android financial management mobile app built with Flutter & SQLite for construction contractors and teams.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">App</span>
            <span class="meta-tag tag-lang">Dart / Flutter</span>
            <span class="meta-tag tag-status">WIP</span>
            <span class="meta-tag">Mobile</span>
          </div>
        </a>

        <!-- 2. CELLTEST POSITIVE -->
        <a href="/en/projects/celltest-positive" class="project-card" data-type="game" data-lang="csharp" data-team="team" data-status="finished" data-platform="pc">
          <h3>CELLTEST POSITIVE</h3>
          <p>1v1 online asymmetric strategy card game built on Host (Cancer) and Client (Antibody) Netcode architecture.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Team</span>
            <span class="meta-tag">PC</span>
          </div>
        </a>

        <!-- 3. ETERNAL DEBT -->
        <a href="/en/projects/eternal-debt" class="project-card" data-type="game" data-lang="csharp" data-team="team" data-status="finished" data-platform="pc">
          <h3>Eternal Debt: Grave Shift</h3>
          <p>Team-oriented Co-op survival game featuring Vivox voice chat integration and custom roles (Digger, Mage, Carrier).</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Co-op</span>
          </div>
        </a>

        <!-- 4. STORY ABOUT FALL -->
        <a href="/en/projects/story-about-fall" class="project-card" data-type="game" data-lang="csharp" data-team="team" data-status="finished" data-platform="pc">
          <h3>Story About Fall</h3>
          <p>Turn-based RPG combining roguelike dungeon progression with JRPG combat mechanics, companion evolution, and Hub farming.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Team</span>
          </div>
        </a>

        <!-- 5. CRAPS WITH THE DEVIL -->
        <a href="/en/projects/craps-with-the-devil" class="project-card" data-type="game" data-lang="csharp" data-team="solo" data-status="finished" data-platform="pc">
          <h3>Craps With The Devil</h3>
          <p>Physics-based atmospheric gambling game depending on the force and angle of the dice with dark magic risk/reward loops.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Solo</span>
          </div>
        </a>

        <!-- 6. THE COUNTY IS DOWN -->
        <a href="/en/projects/the-county-is-down" class="project-card" data-type="game" data-lang="csharp" data-team="solo" data-status="finished" data-platform="web">
          <h3>The County is Down</h3>
          <p>Text-based political strategy game submitted to GMTK Jam 2026 featuring free-text intent parsing and terminal commands.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Web / PC</span>
          </div>
        </a>

        <!-- 7. THE DOOD'S UNIVERSE -->
        <a href="/en/projects/the-doods-universe" class="project-card" data-type="game" data-lang="csharp" data-team="solo" data-status="finished" data-platform="web">
          <h3>The Dood's Universe</h3>
          <p>Cozy town management and social simulation game where you literally draw your buildings, terrain, and citizens.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Web / PC</span>
          </div>
        </a>

        <!-- 8. SKETCH 'EM UP -->
        <a href="/en/projects/sketch-em-up" class="project-card" data-type="game" data-lang="csharp" data-team="team" data-status="finished" data-platform="pc">
          <h3>SKETCH 'EM UP</h3>
          <p>Arcade beat 'em up featuring a hand-drawn boiling line notebook aesthetic with single-player and 2-player local co-op.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Co-op</span>
          </div>
        </a>

        <!-- 9. NETRUNNERS VS CORPOS -->
        <a href="/en/projects/netrunners-vs-corpos" class="project-card" data-type="game" data-lang="csharp" data-team="team" data-status="finished" data-platform="web">
          <h3>Netrunners VS Corpos</h3>
          <p>Asynchronous cyberpunk puzzle/defense game using Unity Gaming Services (UGS) to pull real player cloud replays.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Web / PC</span>
          </div>
        </a>

        <!-- 10. THEOS'S TOOLS -->
        <a href="/en/projects/theos-tools" class="project-card" data-type="toolkit" data-lang="csharp" data-team="solo" data-status="finished" data-platform="multi">
          <h3>Theos's Tools</h3>
          <p>Comprehensive 11-module Unity editor extension package including Node-Based Canvas and Input Integrator.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Toolkit</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Completed</span>
            <span class="meta-tag">Cross-Platform</span>
          </div>
        </a>

        <!-- 11. PATH OF ELEMENTS -->
        <a href="/en/projects/path-of-elements" class="project-card" data-type="game" data-lang="csharp" data-team="solo" data-status="prototype" data-platform="pc">
          <h3>Path of Elements</h3>
          <p>Elemental loop roguelike deck-builder featuring spell fusion algorithms and dynamic terrain manipulation.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Game</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">Paused</span>
            <span class="meta-tag">PC</span>
          </div>
        </a>

        <!-- 12. NIGHTWALKER UNIVERSE -->
        <a href="/en/projects/nightwalker-universe" class="project-card" data-type="system" data-lang="csharp" data-team="solo" data-status="wip" data-platform="pc">
          <h3>Nightwalker Universe</h3>
          <p>Atmospheric first-person game framework featuring a custom character controller, exponential fog shaders, and interaction systems.</p>
          <div class="meta-tags">
            <span class="meta-tag tag-type">Universe / System</span>
            <span class="meta-tag tag-lang">C#</span>
            <span class="meta-tag tag-status">WIP</span>
            <span class="meta-tag">PC</span>
          </div>
        </a>

      </div>
    </div>

    <!-- Filtering Script -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        gsap.to(".anim-header", { opacity: 1, y: -20, duration: 0.8, stagger: 0.2, ease: "power3.out" });
        gsap.fromTo(".project-card", { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.5, stagger: 0.1, delay: 0.5, ease: "back.out(1.5)" });

        const selects = document.querySelectorAll('.filter-panel select');
        const cards = document.querySelectorAll('.project-card');

        selects.forEach(select => {
          select.addEventListener('change', () => {
            const filterType = document.getElementById('filter-type').value;
            const filterLang = document.getElementById('filter-lang').value;
            const filterTeam = document.getElementById('filter-team').value;
            const filterStatus = document.getElementById('filter-status').value;
            const filterPlatform = document.getElementById('filter-platform').value;

            cards.forEach(card => {
              const type = card.getAttribute('data-type');
              const lang = card.getAttribute('data-lang');
              const team = card.getAttribute('data-team');
              const status = card.getAttribute('data-status');
              const platform = card.getAttribute('data-platform');

              const matchType = (filterType === 'all' || filterType === type);
              const matchLang = (filterLang === 'all' || filterLang === lang);
              const matchTeam = (filterTeam === 'all' || filterTeam === team);
              const matchStatus = (filterStatus === 'all' || filterStatus === status);
              const matchPlatform = (filterPlatform === 'all' || filterPlatform === platform);

              if (matchType && matchLang && matchTeam && matchStatus && matchPlatform) {
                card.style.display = "flex";
                gsap.fromTo(card, { opacity: 0, scale: 0.95 }, { opacity: 1, scale: 1, duration: 0.3 });
              } else {
                card.style.display = "none";
              }
            });
          });
        });
      });
    </script>
  </body>
</html>